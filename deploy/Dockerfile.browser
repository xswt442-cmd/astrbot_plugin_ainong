# 浏览器服务镜像
#
# 官方镜像只提供浏览器二进制与 Node 运行时，不含 Playwright 的run-server。
# 所以要在构建阶段把 playwright 装进去——构建时本机有代理，跑起来就不需要。
#
# 这样服务器上既不用开放代理端口，也不用给容器配网络。

FROM mcr.microsoft.com/playwright:v1.63.0-noble

# 锁版本：客户端 Python 包与这里的版本必须一致，错配时协议不兼容。
RUN npm install -g playwright@1.63.0 --no-fund --no-audit \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* /tmp/*

# 浏览器由基础镜像提供，这里只校验 CLI 在位。
RUN playwright --version

WORKDIR /app

# 监听容器网络接口，不是回环：同一 bridge 网络里的其他容器要能连上，
# 而容器间的回环是各自的。端口不映射到宿主机，所以不会对外暴露。
CMD ["playwright", "run-server", "--host=0.0.0.0", "--port=3000"]